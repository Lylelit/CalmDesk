# Скопируйте этот файл в .env.local и вставьте значения из
# Supabase Dashboard → Project Settings → API.
# Работают оба набора имён (предпочтителен VITE_*):
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
# NEXT_PUBLIC_SUPABASE_URL=...            # альтернатива (Next.js-стиль)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...# альтернатива (новый ключ apikey)
